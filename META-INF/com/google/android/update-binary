#!/sbin/sh
# Flash the firmware and logical partition images in this zip on RMX3371.

OUTFD="$2"
ZIPFILE="$3"
DEVICE="RMX3371"
BLOCK_DIR="/dev/block/mapper"
FIRMWARE_DIR="/dev/block/bootdevice/by-name"
IMAGE_LIST="/tmp/images.list"
FIRMWARE_LIST="/tmp/firmware.list"
ROM_INFO="/tmp/rom_info.txt"
RULE="=============================="

set -o pipefail 2>/dev/null

ui_print() {
    printf 'ui_print %s\nui_print\n' "$1" > "/proc/self/fd/$OUTFD"
}

abort() {
    ui_print "ERROR: $1"
    exit 1
}

firmware_partition() {
    case "$1" in
        imagefv) [ -e "$FIRMWARE_DIR/ImageFv_a" ] && echo "ImageFv" || echo "imagefv" ;;
        *) echo "$1" ;;
    esac
}

firmware_targets() {
    case "$1" in
        oplusstanvbk|spunvm|splash) firmware_partition "$1" ;;
        *) echo "$(firmware_partition "$1")_a $(firmware_partition "$1")_b" ;;
    esac
}

check_fits() {
    [ -e "$1" ] || abort "$2 is missing on this device"
    block_size="$(blockdev --getsize64 "$1")" || abort "could not read the size of $2"
    [ "$3" -le "$block_size" ] || abort "$2 image ($3) is bigger than the partition ($block_size)"
}

flash_image() {
    ui_print "Flashing $3"
    blockdev --setrw "$2" || abort "could not make $3 writable"
    unzip -p "$ZIPFILE" "$1" | dd of="$2" bs=1048576 2>/dev/null || abort "failed to write $3"
    sync
    written="$(head -c "$4" "$2" | sha256sum | cut -d' ' -f1)"
    [ "$written" = "$5" ] || abort "$3 failed verification"
}

PRODUCT="$(getprop ro.product.device)"
[ "$PRODUCT" = "$DEVICE" ] || abort "device is '$PRODUCT', expected '$DEVICE'"

for tool in unzip dd blockdev sha256sum head cut; do
    command -v "$tool" >/dev/null || abort "$tool is missing in this recovery"
done

unzip -p "$ZIPFILE" rom_info.txt > "$ROM_INFO" || abort "could not read rom_info.txt"
while IFS= read -r line; do
    ui_print "$line"
done < "$ROM_INFO"
ui_print " "

unzip -p "$ZIPFILE" images.list > "$IMAGE_LIST" || abort "could not read images.list"
[ -s "$IMAGE_LIST" ] || abort "images.list is empty"
unzip -p "$ZIPFILE" firmware.list > "$FIRMWARE_LIST" || abort "could not read firmware.list"
[ -s "$FIRMWARE_LIST" ] || abort "firmware.list is empty"

# Check everything first, so a bad image stops the install before any write.
while read -r name size sha; do
    for target in $(firmware_targets "$name"); do
        check_fits "$FIRMWARE_DIR/$target" "$target" "$size"
    done
done < "$FIRMWARE_LIST"

while read -r name size sha; do
    check_fits "$BLOCK_DIR/${name}_a" "${name}_a" "$size"
done < "$IMAGE_LIST"

ui_print "All checks passed"

SLOT="$(getprop ro.boot.slot_suffix)"
if [ "$SLOT" = "_a" ]; then
    ui_print "Slot a is already active"
else
    ui_print "Current slot is '$SLOT', setting slot a active"
    command -v bootctl >/dev/null || abort "bootctl is missing in this recovery"
    bootctl set-active-boot-slot 0 || abort "could not set slot a active"
fi

ui_print " "
ui_print "--- Flashing firmware ---"
while read -r name size sha; do
    for target in $(firmware_targets "$name"); do
        flash_image "firmware/$name.img" "$FIRMWARE_DIR/$target" "$target" "$size" "$sha"
    done
done < "$FIRMWARE_LIST"

ui_print " "
ui_print "--- Flashing ROM ---"
while read -r name size sha; do
    flash_image "images/$name.img" "$BLOCK_DIR/${name}_a" "${name}_a" "$size" "$sha"
done < "$IMAGE_LIST"

ui_print " "
ui_print "$RULE"
ui_print "    Installation complete"
ui_print "$RULE"
exit 0
